{
    "manifest_version": 3,
    "version": "1.2",
    "name": "LeadMemo",
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "background":{
        "service_worker":"background.js"
    },
    "permissions": [
        "tabs",
        "storage",
        "alarms",
        "notifications"
    ]
}